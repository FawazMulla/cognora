# ─────────────────────────────────────────────────────────────────────────────
# AI Academic Workspace — API environment variables
# Copy this file to .env and fill in the values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (with pgvector extension enabled via Supabase)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/<database>

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=redis://:<password>@<host>:<port>

# ── Authentication ────────────────────────────────────────────────────────────
# At least one of the following must be provided (minimum 32 characters)
NEXTAUTH_SECRET=<generate-with: openssl rand -base64 32>
# JWT_SECRET=<alternative-to-NEXTAUTH_SECRET>

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── AI Provider Keys ─────────────────────────────────────────────────────────
# Google Gemini (Primary): https://aistudio.google.com/
GOOGLE_AI_API_KEY=
# Or alias GEMINI_API_KEY:
# GEMINI_API_KEY=

# Cohere (Command R+): https://dashboard.cohere.com/
COHERE_API_KEY=

# Optional:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

