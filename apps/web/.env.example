# ─────────────────────────────────────────────────────────────────────────────
# Cognora Frontend Environment Variables
# Copy this file to .env.local or .env in apps/web
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL (default: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Preferred AI Provider: "gemini" or "cohere"
VITE_AI_PROVIDER=gemini

# Google Gemini API Key (Direct Frontend / Fallback)
# Get a key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Cohere API Key (Direct Frontend / Fallback)
# Get a key at: https://dashboard.cohere.com/
VITE_COHERE_API_KEY=
